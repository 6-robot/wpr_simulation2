<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="scan_room_world">
    <!-- Gazebo Classic ODE 物理步长配置 -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- 环境光与背景色 -->
    <scene>
      <ambient>0.48 0.52 0.60 1.0</ambient>
      <background>0.06 0.09 0.15 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Gazebo Classic GUI 初始视角：以机器人为中心俯瞰 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.59 -9.92 5.8 0 0.46 1.06</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- 主方向光源与室内顶部补光 -->
    <light type="directional" name="sun_key_light">
      <cast_shadows>true</cast_shadows>
      <pose>4 -6 10 0 0 0</pose>
      <diffuse>0.85 0.90 0.98 1</diffuse>
      <specular>0.3 0.3 0.35 1</specular>
      <direction>-0.35 0.45 -0.82</direction>
    </light>

    <light type="point" name="room_center_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2.9 0 0 0</pose>
      <diffuse>0.65 0.75 0.90 1</diffuse>
      <specular>0.2 0.25 0.3 1</specular>
      <attenuation>
        <range>16</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- 外部无限地平面（防止机器人开出敞开南墙后掉落） -->
    <model name="outer_ground">
      <static>true</static>
      <pose>0 0 -0.105 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.08 0.13 1</ambient>
            <diffuse>0.07 0.10 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 室内建筑墙体（缺南墙）、立柱、天花板梁与家具 -->
    <model name="room_floor">
      <static>true</static>
      <pose>0.0000 0.0000 -0.0500 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>10.2800 8.2800 0.1000</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>10.2800 8.2800 0.1000</size></box>
          </geometry>
          <material>
            <ambient>0.140 0.190 0.270 1.000</ambient>
            <diffuse>0.140 0.190 0.270 1.000</diffuse>
            <specular>0.15 0.18 0.22 1.000</specular>
          </material>
        </visual>
      </link>
    </model>

