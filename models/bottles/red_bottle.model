<?xml version="1.0"?>
<robot name="red_bottle">

<!-- base -->
<link name="base_link">
<visual>
  <geometry>
    <box size="0.01 0.01 0.001" />
  </geometry>
  <origin rpy = "0 0 0" xyz = "0 0 0"/>
</visual>
</link>

<!-- body -->
<link name = "body_link">
  <visual>
    <geometry>
      <mesh filename="package://wpr_simulation2/meshes/bottle.stl" scale="1 1 1"/>
    </geometry>
    <origin rpy = "1.57 0 0" xyz = "-0.03 0.03 0"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.095" rpy="0 0 0" />
    <geometry>
      <cylinder length="0.19" radius="0.03"/>
    </geometry>
  </collision>
  <collision>
    <origin xyz="0 0 0.205" rpy="0 0 0" />
    <geometry>
      <cylinder length="0.03" radius="0.015"/>
    </geometry>
  </collision>
  <inertial>
    <!-- Uniform-density body and neck approximation, retaining the 10 g mass. -->
    <origin xyz="0 0 0.0991772152" rpy="0 0 0"/>
    <mass value="0.01"/>
    <inertia ixx="0.0000355757724" ixy="0" ixz="0" iyy="0.0000355757724" iyz="0" izz="0.00000437183544"/>
  </inertial>
</link>
<joint name = "base_to_body" type = "fixed">
  <parent link = "base_link"/>
  <child link = "body_link"/>
  <origin rpy="0 0 0" xyz="0 0 0"/> <!--pos-->
</joint>
<gazebo reference="body_link">
  <material>Gazebo/Red</material>
</gazebo>

<gazebo reference="body_link">
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <maxVel>0.01</maxVel>
    <minDepth>0.0001</minDepth>
</gazebo>

</robot>
